  // Bind color pickers
  setTimeout(() => {
    ['maroon','cream','gold'].forEach(type => {
      const picker = document.getElementById('fe-color-'+type);
      if (picker) picker.addEventListener('input', () => {
        const hexEl = document.getElementById('fe-color-'+type+'-hex');
        if (hexEl) hexEl.value = picker.value;
      });
    });
  }, 50);
}

// Override loadAdminProducts to also load FE fields
const _origLoadAdmin = loadAdminProducts;
function loadAdminAll() { loadAdminProducts(); loadAdminSettings(); loadFEAdminFields(); }

// ==================== INIT ====================
renderCategories(feData.categories || defaultFE.categories);
renderProducts();
updateCartUI();
applySettings();
applyFE();


</script>
