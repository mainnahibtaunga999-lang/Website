function deleteProduct(id) {
  if (!confirm('Delete this product? This cannot be undone.')) return;
  store.products = store.products.filter(x => x.id !== id);
  saveData('pj_products', store.products);
  loadAdminProducts();
  renderProducts(currentFilter);
}

