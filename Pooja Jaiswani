    const labEl = document.getElementById('stat'+n+'-label');
    if (numEl && fe.stats && fe.stats[i]) numEl.textContent = fe.stats[i].num;
    if (labEl && fe.stats && fe.stats[i]) labEl.textContent = fe.stats[i].label;
  });
  // Testimonials
  [1,2,3].forEach((n,i) => {
    if (!fe.testimonials || !fe.testimonials[i]) return;
    const t = fe.testimonials[i];
    const st = document.getElementById('t'+n+'-stars');
    const tx = document.getElementById('t'+n+'-text');
    const au = document.getElementById('t'+n+'-author');
    if (st) st.textContent = t.stars;
    if (tx) tx.textContent = t.text;
    if (au) au.textContent = t.author;
  });
  // Marquee
  if (fe.marquee) {
    const mt = document.querySelector('.marquee-track');
    if (mt) {
      const items = fe.marquee.split(',').map(s=>s.trim()).filter(Boolean);
      const doubled = [...items,...items];
      mt.innerHTML = doubled.map(item => '<span class="marquee-item">'+item+'</span><span class="marquee-item marquee-dot">✦</span>').join('');
    }
  }
  // Section texts
  const sec = fe.sections || {};
  const setText = (id, val) => { const el=document.getElementById(id); if(el&&val!==undefined) el.textContent=val; };
  const setHTML = (id, val) => { const el=document.getElementById(id); if(el&&val!==undefined) el.innerHTML=val; };
  setText('collections-label', sec.collectionsLabel);
  if (sec.collectionsTitle) setHTML('collections-title', sec.collectionsTitle.replace(/([^ ]+)$/, '<em></em>'));
  setText('shop-label', sec.shopLabel);
  if (sec.shopTitle) setHTML('shop-title', sec.shopTitle.replace(/([^ ]+)$/, '<em></em>'));
  setText('about-label', sec.aboutLabel);
  if (sec.aboutTitle) setHTML('about-title', sec.aboutTitle);
  if (sec.testiTitle) setHTML('testi-title', sec.testiTitle.replace(/([^ ]+)$/, '<em></em>'));
  if (sec.contactTitle) setHTML('contact-title', sec.contactTitle);
  setText('footer-desc', sec.footerDesc);
  setText('footer-copy', sec.footerCopy);
  // Colors
  if (fe.colors) {
    const r = document.documentElement.style;
    if (fe.colors.maroon) {
      r.setProperty('--maroon', fe.colors.maroon);
      r.setProperty('--maroon-light', lightenHex(fe.colors.maroon, 20));
      r.setProperty('--maroon-deep', darkenHex(fe.colors.maroon, 20));
    }
    if (fe.colors.cream) {
      r.setProperty('--cream', fe.colors.cream);
      r.setProperty('--cream-dark', darkenHex(fe.colors.cream, 8));
      r.setProperty('--cream-mid', lightenHex(fe.colors.cream, 4));
    }
    if (fe.colors.gold) r.setProperty('--gold', fe.colors.gold);
  }
  // Announcement
  const annBar = document.getElementById('announcement-bar');
  if (annBar) {
    if (fe.announcement && fe.announcement.trim()) {
      annBar.textContent = fe.announcement;
      annBar.style.display = 'block';
    } else { annBar.style.display = 'none'; }
  }
  // Categories
  if (fe.categories) renderCategories(fe.categories);
}

