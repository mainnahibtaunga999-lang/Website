function hexToRgb(hex) {
  const r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16);
  return [r,g,b];
}
function rgbToHex(r,g,b) {
  return '#' + [r,g,b].map(x => Math.min(255,Math.max(0,Math.round(x))).toString(16).padStart(2,'0')).join('');
}
function lightenHex(hex, amt) { const [r,g,b] = hexToRgb(hex); return rgbToHex(r+amt,g+amt,b+amt); }
function darkenHex(hex, amt) { const [r,g,b] = hexToRgb(hex); return rgbToHex(r-amt,g-amt,b-amt); }
function syncColor(type) {
  const hex = document.getElementById('fe-color-'+type+'-hex').value;
  const picker = document.getElementById('fe-color-'+type);
  if (/^#[0-9A-Fa-f]{6}$/.test(hex) && picker) picker.value = hex;
}

