function updateProduct(id, field, value) {
  const p = store.products.find(x => x.id === id);
  if (!p) return;
  if (field === 'price' || field === 'originalPrice') value = value === '' ? '' : Number(value);
  p[field] = value;
  saveData('pj_products', store.products);
  renderProducts(currentFilter);
}

function addProduct() {
  const newP = { id: nextId++, name: 'New Product', category: 'Kurti', price: 999, originalPrice: '', image: '', bestseller: false, sale: false, hidden: false };
  store.products.push(newP);
  saveData('pj_products', store.products);
  loadAdminProducts();
  renderProducts(currentFilter);
  document.getElementById('admin-products-list').lastElementChild?.scrollIntoView({ behavior: 'smooth' });
